# Copy this file to .env (in the same directory) and fill in your own values.
# .env is git-ignored and must never be committed.

# Required: your OpenAI API key. Paste it here directly — never in chat, never in code.
OPENAI_API_KEY=

# Optional: model used ONLY by the RAG course-recommendation prototype
# (outputs/rag_recommendation_prototype_api/). This is deliberately a separate
# variable from any model used by other features (e.g. Reflection Journey) so the
# recommendation system can be configured/priced independently.
# Default if left blank: gpt-4o-mini (chosen for structured-output support, moderate
# context, and low per-call cost appropriate for a small prototype run — not live-
# verified against your account since no key was available when this default was set;
# override with any model your account/SDK supports).
OPENAI_RECOMMENDATION_MODEL=gpt-4o-mini
